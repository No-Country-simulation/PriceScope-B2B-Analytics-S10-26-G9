# =============================================================================
# PriceScope backend — variables de entorno
#
# Local:      copiá este archivo a `.env`. Los valores sirven tal cual con
#             `docker compose up -d` (TimescaleDB y Redis), salvo SMTP_PASSWORD.
# Producción: no se usa archivo. Cargá las variables en Railway, en el servicio
#             de la API y en el del worker (los dos necesitan las mismas).
# =============================================================================

# Entorno: local | test | staging | production
# Fuera de local/test las cookies se marcan como Secure (requiere HTTPS).
ENVIRONMENT=local

# --- PostgreSQL / TimescaleDB -------------------------------------------------
# docker-compose usa USER/PASSWORD/DB para crear la base local.
POSTGRES_USER=pricescope
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=pricescope
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Railway:
# POSTGRES_HOST=${{timescaledb.RAILWAY_PRIVATE_DOMAIN}}
# POSTGRES_USER=${{timescaledb.POSTGRES_USER}}
# POSTGRES_PASSWORD=${{timescaledb.POSTGRES_PASSWORD}}
# POSTGRES_DB=${{timescaledb.POSTGRES_DB}}

# --- Redis (cola de ARQ y rate limit del scraping) ----------------------------
# Local: host y puerto alcanzan.
REDIS_HOST=localhost
REDIS_PORT=6379
# Producción: URL completa con contraseña. Si está definida, reemplaza host/puerto.
# REDIS_URL=${{Redis.REDIS_URL}}

# --- Seguridad ----------------------------------------------------------------
# En producción generalo con: openssl rand -hex 32  (el mismo en API y worker)
JWT_SECRET=cambia-este-secreto
# Opcionales (valores por defecto):
# ACCESS_TOKEN_MINUTES=15
# SESSION_INACTIVITY_MINUTES=30
# SESSION_MAX_HOURS=12
# SET_PASSWORD_TOKEN_HOURS=72
# RESET_TOKEN_MINUTES=60
# EMAIL_CHANGE_TOKEN_MINUTES=30

# --- Frontend -----------------------------------------------------------------
# Base de los enlaces de los correos (bienvenida, recuperar contraseña).
# Producción: la URL de Vercel, ej. https://pricescope.vercel.app
FRONTEND_URL=http://localhost:3000
# El front llama a la API a través de su propio rewrite (/api/v1), así que no
# hace falta CORS. Solo definilo si un cliente llama a la API directo desde otro origen:
# CORS_ORIGINS='["http://localhost:3000"]'

# --- Correo (Resend por SMTP, en local y en producción) -----------------------
# https://resend.com/docs/send-with-smtp — los correos son reales también en local.
# Host, puerto, usuario y TLS ya vienen por defecto; solo falta la API key.
SMTP_PASSWORD=re_xxxxxxxxx
# Sin dominio verificado, Resend solo entrega a la dirección de tu cuenta de Resend.
# Con un dominio verificado, cambiá el remitente:
# MAIL_SENDER="PriceScope <no-responder@tu-dominio-verificado.com>"

# --- Scraping (deshabilitado por defecto) -------------------------------------
SCRAPING_ENABLED=false
SCRAPING_JOBS_ENABLED=false
SCRAPING_ALLOWED_STORES='[]'
SCRAPING_SELLER_IDS='{}'
# Ejemplo con tiendas autorizadas:
# SCRAPING_ALLOWED_STORES='["carrefour","jumbo"]'
# SCRAPING_SELLER_IDS='{"carrefour":["1"],"jumbo":["1"]}'

# --- Seed (opcional) ----------------------------------------------------------
# `python -m scripts.seed` pide los datos del admin por consola; con estas
# variables corre sin preguntar. En producción borralas después de usarlas.
# SEED_ADMIN_EMAIL=admin@pricescope.local
# SEED_ADMIN_NAME=Admin PriceScope
# SEED_ADMIN_PASSWORD=Cambiame123
