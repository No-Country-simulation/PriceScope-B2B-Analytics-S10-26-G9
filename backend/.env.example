POSTGRES_USER=pricescope
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=pricescope
JWT_SECRET=cambia-este-secreto

# Base de los enlaces de los correos (bienvenida, recuperar contraseña): donde corre el frontend.
FRONTEND_URL=http://localhost:3000

# Scraping: deshabilitado por defecto
SCRAPING_ENABLED=false
SCRAPING_ALLOWED_STORES='[]'
SCRAPING_SELLER_IDS='{}'

# Ejemplo de configuracion para tiendas autorizadas:
# SCRAPING_ALLOWED_STORES='["carrefour","jumbo"]'
# SCRAPING_SELLER_IDS='{"carrefour":["1"],"jumbo":["1"]}'
# Correo: en local los valores por defecto apuntan a Mailpit (localhost:1025), no hace falta definirlos.
# En staging/producción usamos Resend por SMTP (https://resend.com/docs/send-with-smtp):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxx
# SMTP_TLS=true
# MAIL_SENDER="PriceScope <no-responder@tu-dominio-verificado.com>"
