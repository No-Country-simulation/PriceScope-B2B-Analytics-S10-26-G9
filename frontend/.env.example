# Backend API origin used by the /api/v1 rewrite.
BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFyeT3HkPkAGJzJx

# Test account shown in an alert on /ingresar. Leave empty to hide it.
# Must match the user created with `python -m scripts.seed` (SEED_ADMIN_*).
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Cloudflare Turnstile site key (public) for the challenge on /ingresar.
# Leave empty to skip it. The secret key belongs to the backend, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
