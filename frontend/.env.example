# =============================================================================
# PriceScope frontend — environment variables
#
# Local:      copy this file to `.env.local`. The defaults point to the backend
#             running on http://localhost:8000.
# Production: set these in Vercel → Settings → Environment Variables
#             (Production and Preview), then redeploy: they are read at build time.
# =============================================================================

# Backend origin used by the /api/v1 rewrite in next.config.ts.
# `pnpm dev` uses this value; `pnpm dev:prod` overrides it with the Railway API.
# The browser only talks to this app, so the refresh cookie stays first-party.
# Production: the Railway API domain, without a trailing slash or /api/v1, e.g.
# BACKEND_URL=https://pricescope-b2b-analytics-s10-26-g9-production.up.railway.app
BACKEND_URL=http://localhost:8000

# Test account shown in an alert on /ingresar. Leave empty to hide it.
# Must match a user created with `python -m scripts.seed`.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Cloudflare Turnstile site key (public) for the challenge on /ingresar.
# Leave empty to skip it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
